#include "klor_common.dtsi"

/ {
	chosen {
		zmk,physical-layout = &klor_layout;
	};

	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <10>;
		rows = <4>;
		map = 
        RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)		 RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
		RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)		 RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
		RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) 	 RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
                        RC(3,2) RC(3,3) RC(3,4) 	 RC(3,5) RC(3,6) RC(3,7)
		>;
	};

	klor_layout: klor_layout {
		compatible = "zmk,physical-layout";
		display-name = "KLOR";
		transform = <&default_transform>;
		kscan = <&kscan0>;
		keys  //                     w   h    x    y   rot   rx   ry
			= <&key_physical_attrs 100 100   20  444    10   20  444>
			, <&key_physical_attrs 100 100  134  368     4  134  368>
			, <&key_physical_attrs 100 100  249  313     0  249  313>
			, <&key_physical_attrs 100 100  349  360     0  349  360>
			, <&key_physical_attrs 100 100  448  376     0  448  376>
			, <&key_physical_attrs 100 100 1114  444   -10 1114  444>
			, <&key_physical_attrs 100 100 1000  368    -4 1000  368>
			, <&key_physical_attrs 100 100  885  313     0  885  313>
			, <&key_physical_attrs 100 100  785  360     0  785  360>
			, <&key_physical_attrs 100 100  686  376     0  686  376>

			, <&key_physical_attrs 100 100   37  542    10   37  542>
			, <&key_physical_attrs 100 100  141  467     4  141  467>
			, <&key_physical_attrs 100 100  249  413     0  249  413>
			, <&key_physical_attrs 100 100  349  460     0  349  460>
			, <&key_physical_attrs 100 100  448  476     0  448  476>
			, <&key_physical_attrs 100 100 1097  542   -10 1097  542>
			, <&key_physical_attrs 100 100  993  467    -4  993  467>
			, <&key_physical_attrs 100 100  885  413     0  885  413>
			, <&key_physical_attrs 100 100  785  460     0  785  460>
			, <&key_physical_attrs 100 100  686  476     0  686  476>

			, <&key_physical_attrs 100 100   55  641    10   55  641>
			, <&key_physical_attrs 100 100  148  567     4  148  567>
			, <&key_physical_attrs 100 100  249  513     0  249  513>
			, <&key_physical_attrs 100 100  349  560     0  349  560>
			, <&key_physical_attrs 100 100  448  576     0  448  576>
			, <&key_physical_attrs 100 100 1079  641   -10 1079  641>
			, <&key_physical_attrs 100 100  986  567    -4  986  567>
			, <&key_physical_attrs 100 100  885  513     0  885  513>
			, <&key_physical_attrs 100 100  785  560     0  785  560>
			, <&key_physical_attrs 100 100  686  576     0  686  576>

			, <&key_physical_attrs 100 100  537  734 -15000  537  734>
			, <&key_physical_attrs 100 100  640  691 -16500  640  691>
			, <&key_physical_attrs 100 100  751  676  18000  751  676>
			, <&key_physical_attrs 100 100  333  676  18000  333  676>
			, <&key_physical_attrs 100 100  225  691  16500  225  691>
			, <&key_physical_attrs 100 100  122  734  15000  122  734>
			;
	};
};

&kscan0 {
	row-gpios
		= <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		;
};
