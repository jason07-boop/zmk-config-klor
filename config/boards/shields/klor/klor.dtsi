// boards/shields/klor/klor.dtsi
#include <zmk/keys.dtsi>

/ {
    // No chosen block here; it will be defined in the overlays
};

&kscan0 {
    compatible = "zmk,kscan-gpio-matrix";
    diode-direction = "col2row"; // Verify this matches your wiring
    wakeup-source;
    
    // SHARED ROW PINS (If both halves use the same pins for rows)
    row-gpios
        = <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        ;
    // col-gpios is NOT defined here
};   
