//                               █    █         █       █                    █   █▄▄▄▄▄▄▄▄▄▄█
//                               █   █ █        █       █                    █   █      █
//                               █  █   █       █        █                  █    █       █
//                               █ █     █      █        ▀▄                ▄▀    █        █
//                               ██       █     █          ▀▄            ▄▀      █         █
//                               █         █    █▄▄▄▄▄▄▄▄    ▀▀▀▄▄▄▄▄▄▀▀▀        █          █
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&mmv {
    delay-ms = <0>;
    time-to-max-speed-ms = <1500>;
    acceleration-exponent = <1>;
};

/ {
    behaviors {
        u_to_U_base: u_to_U_base {
            compatible = "zmk,behavior-tap-dance";
            label = "U_TO_U_BASE";
            #binding-cells = <0>;
            bindings = <&none>, <&to 0>;
        };

        u_to_U_game: u_to_U_game {
            compatible = "zmk,behavior-tap-dance";
            label = "U_TO_U_GAME";
            #binding-cells = <0>;
            bindings = <&none>, <&to 0>;
        };

        u_to_U_nav: u_to_U_nav {
            compatible = "zmk,behavior-tap-dance";
            label = "U_TO_U_NAV";
            #binding-cells = <0>;
            bindings = <&none>, <&to 2>;
        };

        u_to_U_num: u_to_U_num {
            compatible = "zmk,behavior-tap-dance";
            label = "U_TO_U_NUM";
            #binding-cells = <0>;
            bindings = <&none>, <&to 5>;
        };

        u_to_U_media: u_to_U_media {
            compatible = "zmk,behavior-tap-dance";
            label = "U_TO_U_MEDIA";
            #binding-cells = <0>;
            bindings = <&none>, <&to 3>;
        };

        u_to_U_fun: u_to_U_fun {
            compatible = "zmk,behavior-tap-dance";
            label = "U_TO_U_FUN";
            #binding-cells = <0>;
            bindings = <&none>, <&to 7>;
        };

        u_to_U_mouse: u_to_U_mouse {
            compatible = "zmk,behavior-tap-dance";
            label = "U_TO_U_MOUSE";
            #binding-cells = <0>;
            bindings = <&none>, <&to 4>;
        };

        u_to_U_sym: u_to_U_sym {
            compatible = "zmk,behavior-tap-dance";
            label = "U_TO_U_SYM";
            #binding-cells = <0>;
            bindings = <&none>, <&to 6>;
        };

        u_bootloader: u_bootloader {
            compatible = "zmk,behavior-tap-dance";
            label = "U_BOOTLOADER";
            #binding-cells = <0>;
            bindings = <&none>, <&bootloader>;
        };

        u_bt_sel_0: u_bt_sel_0 {
            compatible = "zmk,behavior-mod-morph";
            label = "U_BT_SEL_0";
            bindings = <&bt BT_SEL 0>, <&u_macro_u_bt_sel_0>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        u_bt_sel_1: u_bt_sel_1 {
            compatible = "zmk,behavior-mod-morph";
            label = "U_BT_SEL_1";
            bindings = <&bt BT_SEL 1>, <&u_macro_u_bt_sel_1>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        u_bt_sel_2: u_bt_sel_2 {
            compatible = "zmk,behavior-mod-morph";
            label = "U_BT_SEL_2";
            bindings = <&bt BT_SEL 2>, <&u_macro_u_bt_sel_2>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        u_bt_sel_3: u_bt_sel_3 {
            compatible = "zmk,behavior-mod-morph";
            label = "U_BT_SEL_3";
            bindings = <&bt BT_SEL 3>, <&u_macro_u_bt_sel_3>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        u_bt_sel_4: u_bt_sel_4 {
            compatible = "zmk,behavior-mod-morph";
            label = "U_BT_SEL_4";
            bindings = <&bt BT_SEL 4>, <&u_macro_u_bt_sel_4>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        u_out_tog: u_out_tog {
            compatible = "zmk,behavior-mod-morph";
            label = "U_OUT_TOG";
            bindings = <&out OUT_TOG>, <&out OUT_USB>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        u_caps_word: u_caps_word {
            compatible = "zmk,behavior-mod-morph";
            label = "U_CAPS_WORD";
            bindings = <&caps_word>, <&kp CAPS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        u_to_U_extra: u_to_U_extra {
            compatible = "zmk,behavior-tap-dance";
            label = "U_TO_U_EXTRA";
            #binding-cells = <0>;
            bindings = <&none>, <&to 0>;
        };

        home_row_mod_left: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MOD_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            quick-tap-ms = <175>;
            tapping-term-ms = <280>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29>;
        };

        home_row_mod_right: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MOD_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24>;
            hold-trigger-on-release;
        };

        u_to_U_button: u_to_U_button {
            compatible = "zmk,behavior-tap-dance";
            label = "U_TO_U_BUTTON";
            #binding-cells = <0>;
            bindings = <&none>, <&to 0>;
        };

        auto_shift: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTO_SHIFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <135>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
        };

        game_fkey1: game_fkey1 {
            compatible = "zmk,behavior-mod-morph";
            label = "GAME_FKEY1";
            bindings = <&kp NUMBER_1>, <&kp F1>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };

        game_fkey2: game_fkey2 {
            compatible = "zmk,behavior-mod-morph";
            label = "GAME_FKEY2";
            bindings = <&kp NUMBER_2>, <&kp F2>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };

        game_fkey3: game_fkey3 {
            compatible = "zmk,behavior-mod-morph";
            label = "GAME_FKEY3";
            bindings = <&kp NUMBER_3>, <&kp F3>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };

        game_fkey4: game_fkey4 {
            compatible = "zmk,behavior-mod-morph";
            label = "GAME_FKEY4";
            bindings = <&kp NUMBER_4>, <&kp F4>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };

        game_fkey5: game_fkey5 {
            compatible = "zmk,behavior-mod-morph";
            label = "GAME_FKEY5";
            bindings = <&kp NUMBER_5>, <&kp F5>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };

        game_fkey6: game_fkey6 {
            compatible = "zmk,behavior-mod-morph";
            label = "GAME_FKEY6";
            bindings = <&kp NUMBER_6>, <&kp F6>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };

        game_fkey7: game_fkey7 {
            compatible = "zmk,behavior-mod-morph";
            label = "GAME_FKEY7";
            bindings = <&kp NUMBER_7>, <&kp F7>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };

        game_fkey8: game_fkey8 {
            compatible = "zmk,behavior-mod-morph";
            label = "GAME_FKEY8";
            bindings = <&kp NUMBER_8>, <&kp F8>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };

        game_fkey9: game_fkey9 {
            compatible = "zmk,behavior-mod-morph";
            label = "GAME_FKEY9";
            bindings = <&kp NUMBER_9>, <&kp F9>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };

        game_fkey10: game_fkey10 {
            compatible = "zmk,behavior-mod-morph";
            label = "GAME_FKEY10";
            bindings = <&kp NUMBER_0>, <&kp F10>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };

        game_fkey11: game_fkey11 {
            compatible = "zmk,behavior-mod-morph";
            label = "GAME_FKEY11";
            bindings = <&kp ESCAPE>, <&kp F11>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };

        game_fkey12: game_fkey12 {
            compatible = "zmk,behavior-mod-morph";
            label = "GAME_FKEY12";
            bindings = <&kp GRAVE>, <&kp F12>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        DUALLOCK {
            bindings = <&kp CAPS>;
            key-positions = <13 16>;
            layers = <0>;
        };
    };

    macros {
        u_macro_u_bt_sel_0: u_macro_u_bt_sel_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &bt BT_CLR>;
            label = "U_MACRO_U_BT_SEL_0";
        };

        u_macro_u_bt_sel_1: u_macro_u_bt_sel_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &bt BT_CLR>;
            label = "U_MACRO_U_BT_SEL_1";
        };

        u_macro_u_bt_sel_2: u_macro_u_bt_sel_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2 &bt BT_CLR>;
            label = "U_MACRO_U_BT_SEL_2";
        };

        u_macro_u_bt_sel_3: u_macro_u_bt_sel_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3 &bt BT_CLR>;
            label = "U_MACRO_U_BT_SEL_3";
        };

        u_macro_u_bt_sel_4: u_macro_u_bt_sel_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4 &bt BT_CLR>;
            label = "U_MACRO_U_BT_SEL_4";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        BASE {
            // ┌─────────────────────────────────────────────────┐

            label = "BASE";

            // └─────────────────────────────────────────────────┘
            /* ┌─────────┬─────────┬─────────┬─────────┬─────────┐┌─────────┬─────────┬─────────┬─────────┬─────────┐
   │    Q    │    W    │    F    │    P    │    G    ││    J    │    L    │    U    │    Y    │    ;    │   
   ├─────────┼─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┼─────────┐
   │    A    │    R    │    S    │    T    │    D    ││    H    │    N    │    E    │    I    │    O    │
   ├─────────┼─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┼─────────┤
   │    Z    │    X    │    C    │    V    │    B    ││    K    │    M    │    ,    │    .    │    /    │
   └─────────┴─────────┼─────────┼─────────┼─────────┼┼─────────┼─────────┼─────────┼─────────┴─────────┘
                       │  CTRL   │  LOWER  │  SPACE  ││  ENTER  │  RAISE  │  BSPCE  │  
                       └─────────┴─────────┴─────────┘└─────────┴─────────┴─────────┘ */

            bindings = <
&kp V                          &kp L                      &kp H                       &kp G                       &kp K      &kp Q      &kp F                        &kp O                        &kp U                          &kp J
&home_row_mod_left LEFT_GUI S  &home_row_mod_left LALT R  &home_row_mod_left LCTRL N  &home_row_mod_left LSHFT T  &kp B      &kp Y      &home_row_mod_right LSHFT C  &home_row_mod_right LCTRL A  &home_row_mod_right LALT E     &home_row_mod_right LEFT_GUI I
&kp Z                          &home_row_mod_left RALT X  &kp M                       &kp D                       &kp P      &kp SQT    &kp W                        &kp DOT                      &home_row_mod_right RALT SEMI  &kp COMMA
                                                                                      &lt 5 ESC                   &lt 4 RET  &lt 6 TAB  &lt 7 SPACE                  &lt 8 BACKSPACE              &lt 9 DEL
            >;
        };

        EXTRA {
            label = "EXTRA";
            bindings = <
&kp Q                          &kp W                      &kp E                       &kp R                       &kp T    &kp Y    &kp U                        &kp I                        &kp O                          &kp P
&home_row_mod_left LEFT_GUI A  &home_row_mod_left LALT S  &home_row_mod_left LCTRL D  &home_row_mod_left LSHFT F  &kp G    &kp H    &home_row_mod_right LSHFT J  &home_row_mod_right LCTRL K  &home_row_mod_right LALT L     &home_row_mod_right LEFT_GUI SQT
&kp Z                          &home_row_mod_left RALT X  &kp C                       &kp V                       &kp B    &kp N    &kp M                        &kp COMMA                    &home_row_mod_right RALT SEMI  &kp FSLH
                                                                                      &lt 5 ESC                   &lt 4 RET  &lt 6 TAB  &lt 7 SPACE                  &lt 8 BACKSPACE              &lt 9 DEL
            >;
        };

        GAME {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        BUTTON {
            bindings = <
&kp LC(Z)     &kp LC(X)     &kp LC(C)  &kp LC(V)   &kp LC(Y)                        &kp LC(Y)  &kp LC(V)       &kp LC(C)  &kp LC(X)     &kp LC(Z)
&kp LEFT_GUI  &kp LEFT_ALT  &kp LCTRL  &kp LSHIFT  &kp LC(A)                        &kp LC(A)  &kp LEFT_SHIFT  &kp LCTRL  &kp LEFT_ALT  &kp LEFT_WIN
&kp LC(Z)     &kp LC(X)     &kp LC(C)  &kp LC(V)   &kp LC(Y)                        &kp LC(Y)  &kp LC(V)       &kp LC(C)  &kp LC(X)     &kp LC(Z)
                               &mkp MB3    &mkp MB1   &mkp MB2    &mkp MB2  &mkp MB1   &mkp MB3
            >;
        };

        NAV {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        MEDIA {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        NUM {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        SYM {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        FUN {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
