//                               █         █    █            ▄▄▄▀▀▀▀▀▀▄▄▄        █▀▀▀▀▀▀▀▀▀▀█
//                               █        █     █          ▄▀            ▀▄      █          █
//                               █       █      █        ▄▀                ▀▄    █          █
//                               █      █       █        █                  █    █          █
//                               █     █        █       █                    █   █          █
//                               █    █         █       █                    █   █▄▄▄▄▄▄▄▄▄▄█
//                               █   █ █        █       █                    █   █      █
//                               █  █   █       █        █                  █    █       █
//                               █ █     █      █        ▀▄                ▄▀    █        █
//                               ██       █     █          ▀▄            ▄▀      █         █
//                               █         █    █▄▄▄▄▄▄▄▄    ▀▀▀▄▄▄▄▄▄▀▀▀        █          █
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE   0
#define LOWER  1
#define RAISE  2
#define ADJUST 3

&mmv {
    delay-ms = <0>;
    time-to-max-speed-ms = <1500>;
    acceleration-exponent = <1>;
};

/ {
    behaviors {
        u_to_U_base: u_to_U_base {
            compatible = "zmk,behavior-tap-dance";
            label = "U_TO_U_BASE";
            #binding-cells = <0>;
            bindings = <&none>, <&to 0>;
        };

        u_to_U_game: u_to_U_game {
            compatible = "zmk,behavior-tap-dance";
            label = "U_TO_U_GAME";
            #binding-cells = <0>;
            bindings = <&none>, <&to 2>;
        };

        u_to_U_nav: u_to_U_nav {
            compatible = "zmk,behavior-tap-dance";
            label = "U_TO_U_NAV";
            #binding-cells = <0>;
            bindings = <&none>, <&to 4>;
        };

        u_to_U_num: u_to_U_num {
            compatible = "zmk,behavior-tap-dance";
            label = "U_TO_U_NUM";
            #binding-cells = <0>;
            bindings = <&none>, <&to 7>;
        };

        u_to_U_media: u_to_U_media {
            compatible = "zmk,behavior-tap-dance";
            label = "U_TO_U_MEDIA";
            #binding-cells = <0>;
            bindings = <&none>, <&to 5>;
        };

        u_to_U_fun: u_to_U_fun {
            compatible = "zmk,behavior-tap-dance";
            label = "U_TO_U_FUN";
            #binding-cells = <0>;
            bindings = <&none>, <&to 9>;
        };

        u_to_U_mouse: u_to_U_mouse {
            compatible = "zmk,behavior-tap-dance";
            label = "U_TO_U_MOUSE";
            #binding-cells = <0>;
            bindings = <&none>, <&to 6>;
        };

        u_to_U_sym: u_to_U_sym {
            compatible = "zmk,behavior-tap-dance";
            label = "U_TO_U_SYM";
            #binding-cells = <0>;
            bindings = <&none>, <&to 8>;
        };

        u_bootloader: u_bootloader {
            compatible = "zmk,behavior-tap-dance";
            label = "U_BOOTLOADER";
            #binding-cells = <0>;
            bindings = <&none>, <&bootloader>;
        };

        u_bt_sel_0: u_bt_sel_0 {
            compatible = "zmk,behavior-mod-morph";
            label = "U_BT_SEL_0";
            bindings = <&bt BT_SEL 0>, <&u_macro_u_bt_sel_0>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        u_bt_sel_1: u_bt_sel_1 {
            compatible = "zmk,behavior-mod-morph";
            label = "U_BT_SEL_1";
            bindings = <&bt BT_SEL 1>, <&u_macro_u_bt_sel_1>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        u_bt_sel_2: u_bt_sel_2 {
            compatible = "zmk,behavior-mod-morph";
            label = "U_BT_SEL_2";
            bindings = <&bt BT_SEL 2>, <&u_macro_u_bt_sel_2>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        u_bt_sel_3: u_bt_sel_3 {
            compatible = "zmk,behavior-mod-morph";
            label = "U_BT_SEL_3";
            bindings = <&bt BT_SEL 3>, <&u_macro_u_bt_sel_3>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        u_bt_sel_4: u_bt_sel_4 {
            compatible = "zmk,behavior-mod-morph";
            label = "U_BT_SEL_4";
            bindings = <&bt BT_SEL 4>, <&u_macro_u_bt_sel_4>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        u_out_tog: u_out_tog {
            compatible = "zmk,behavior-mod-morph";
            label = "U_OUT_TOG";
            bindings = <&out OUT_TOG>, <&out OUT_USB>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        u_caps_word: u_caps_word {
            compatible = "zmk,behavior-mod-morph";
            label = "U_CAPS_WORD";
            bindings = <&caps_word>, <&kp CAPS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        u_to_U_extra: u_to_U_extra {
            compatible = "zmk,behavior-tap-dance";
            label = "U_TO_U_EXTRA";
            #binding-cells = <0>;
            bindings = <&none>, <&to 1>;
        };

        home_row_mod_left: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MOD_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            quick-tap-ms = <175>;
            tapping-term-ms = <280>;
            hold-trigger-on-release;
        };

        home_row_mod_right: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MOD_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24>;
            hold-trigger-on-release;
        };

        u_to_U_button: u_to_U_button {
            compatible = "zmk,behavior-tap-dance";
            label = "U_TO_U_BUTTON";
            #binding-cells = <0>;
            bindings = <&none>, <&to 3>;
        };

        auto_shift: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTO_SHIFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <135>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
        };

        game_fkey1: game_fkey1 {
            compatible = "zmk,behavior-mod-morph";
            label = "GAME_FKEY1";
            bindings = <&kp NUMBER_1>, <&kp F1>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };

        game_fkey2: game_fkey2 {
            compatible = "zmk,behavior-mod-morph";
            label = "GAME_FKEY2";
            bindings = <&kp NUMBER_2>, <&kp F2>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };

        game_fkey3: game_fkey3 {
            compatible = "zmk,behavior-mod-morph";
            label = "GAME_FKEY3";
            bindings = <&kp NUMBER_3>, <&kp F3>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };

        game_fkey4: game_fkey4 {
            compatible = "zmk,behavior-mod-morph";
            label = "GAME_FKEY4";
            bindings = <&kp NUMBER_4>, <&kp F4>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };

        game_fkey5: game_fkey5 {
            compatible = "zmk,behavior-mod-morph";
            label = "GAME_FKEY5";
            bindings = <&kp NUMBER_5>, <&kp F5>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };

        game_fkey6: game_fkey6 {
            compatible = "zmk,behavior-mod-morph";
            label = "GAME_FKEY6";
            bindings = <&kp NUMBER_6>, <&kp F6>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };

        game_fkey7: game_fkey7 {
            compatible = "zmk,behavior-mod-morph";
            label = "GAME_FKEY7";
            bindings = <&kp NUMBER_7>, <&kp F7>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };

        game_fkey8: game_fkey8 {
            compatible = "zmk,behavior-mod-morph";
            label = "GAME_FKEY8";
            bindings = <&kp NUMBER_8>, <&kp F8>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };

        game_fkey9: game_fkey9 {
            compatible = "zmk,behavior-mod-morph";
            label = "GAME_FKEY9";
            bindings = <&kp NUMBER_9>, <&kp F9>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };

        game_fkey10: game_fkey10 {
            compatible = "zmk,behavior-mod-morph";
            label = "GAME_FKEY10";
            bindings = <&kp NUMBER_0>, <&kp F10>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };

        game_fkey11: game_fkey11 {
            compatible = "zmk,behavior-mod-morph";
            label = "GAME_FKEY11";
            bindings = <&kp ESCAPE>, <&kp F11>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };

        game_fkey12: game_fkey12 {
            compatible = "zmk,behavior-mod-morph";
            label = "GAME_FKEY12";
            bindings = <&kp GRAVE>, <&kp F12>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        DUALLOCK {
            bindings = <&kp CAPS>;
            key-positions = <13 16>;
            layers = <0>;
        };
    };

    macros {
        u_macro_u_bt_sel_0: u_macro_u_bt_sel_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &bt BT_CLR>;
            label = "U_MACRO_U_BT_SEL_0";
        };

        u_macro_u_bt_sel_1: u_macro_u_bt_sel_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &bt BT_CLR>;
            label = "U_MACRO_U_BT_SEL_1";
        };

        u_macro_u_bt_sel_2: u_macro_u_bt_sel_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2 &bt BT_CLR>;
            label = "U_MACRO_U_BT_SEL_2";
        };

        u_macro_u_bt_sel_3: u_macro_u_bt_sel_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3 &bt BT_CLR>;
            label = "U_MACRO_U_BT_SEL_3";
        };

        u_macro_u_bt_sel_4: u_macro_u_bt_sel_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4 &bt BT_CLR>;
            label = "U_MACRO_U_BT_SEL_4";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        base_layer {
            // ┌─────────────────────────────────────────────────┐

            label = "BASE";

            // └─────────────────────────────────────────────────┘
            /* ┌─────────┬─────────┬─────────┬─────────┬─────────┐┌─────────┬─────────┬─────────┬─────────┬─────────┐
   │    Q    │    W    │    F    │    P    │    G    ││    J    │    L    │    U    │    Y    │    ;    │   
   ├─────────┼─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┼─────────┐
   │    A    │    R    │    S    │    T    │    D    ││    H    │    N    │    E    │    I    │    O    │
   ├─────────┼─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┼─────────┤
   │    Z    │    X    │    C    │    V    │    B    ││    K    │    M    │    ,    │    .    │    /    │
   └─────────┴─────────┼─────────┼─────────┼─────────┼┼─────────┼─────────┼─────────┼─────────┴─────────┘
                       │  CTRL   │  LOWER  │  SPACE  ││  ENTER  │  RAISE  │  BSPCE  │  
                       └─────────┴─────────┴─────────┘└─────────┴─────────┴─────────┘ */

            bindings = <
&kp Q  &kp W  &kp F  &kp P        &kp G      &kp J      &kp L        &kp U      &kp Y     &kp SEMI
&kp A  &kp R  &kp S  &hm LSHFT T  &kp D      &kp H      &hm RSHFT N  &kp E      &kp I     &kp O
&kp Z  &kp X  &kp C  &kp V        &kp B      &kp K      &kp M        &kp COMMA  &kp DOT   &kp FSLH
                     &kp LCTRL    &mo LOWER  &kp SPACE  &kp RET      &mo RAISE  &kp BSPC
            >;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        lower_layer {
            // ┌─────────────────────────────────────────────────┐

            label = "LOWER";

            // └─────────────────────────────────────────────────┘
            /* ┌─────────┬─────────┬─────────┬─────────┬─────────┐┌─────────┬─────────┬─────────┬─────────┬─────────┐
   │         │         │    UP   │         │    {    ││    }    │    7    │    8    │    9    │    +    │
   ┌─────────┼─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┼─────────┐
   │         │   LEFT  │  DOWN   │  RIGHT  │    [    ││    ]    │    4    │    5    │    6    │    -    │
   ├─────────┼─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┼─────────┤
   │         │   P UP  │ C LOCK  │ P DOWN  │    (    ││    )    │    1    │    2    │    3    │    *    │
   └─────────┴─────────┼─────────┼─────────┼─────────┼┼─────────┼─────────┼─────────┼─────────┴─────────┘
                       │         │         │         ││         │    0    │         │  
                       └─────────┴─────────┴─────────┘└─────────┴─────────┴─────────┘ */

            bindings = <
&ext_power EP_TOG  &trans     &kp UP    &trans     &kp LBRC  &kp RBRC  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_PLUS
&rgb_ug RGB_EFF    &kp LEFT   &kp DOWN  &kp RIGHT  &kp LBKT  &kp RBKT  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_MINUS
&trans             &kp PG_UP  &kp CAPS  &kp PG_DN  &kp LPAR  &kp RPAR  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_MULTIPLY
                                        &trans     &trans    &trans    &trans     &kp KP_N0  &trans
            >;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        raise_layer {
            // ┌─────────────────────────────────────────────────┐

            label = "RAISE";

            // └─────────────────────────────────────────────────┘
            /* ┌─────────┬─────────┬─────────┬─────────┬─────────┐┌─────────┬─────────┬─────────┬─────────┬─────────┐
   │         │         │         │         │         ││         │         │    Ü    │         │         │
   ┌─────────┼─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┼─────────┐
   │         │    ß    │         │         │         ││         │         │         │         │    Ö    │
   ├─────────┼─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┼─────────┤
   │         │         │         │         │         ││         │         │         │         │         │
   └─────────┴─────────┼─────────┼─────────┼─────────┼┼─────────┼─────────┼─────────┼─────────┴─────────┘
                       │ ADJUST  │         │         ││         │         │         │  
                       └─────────┴─────────┴─────────┘└─────────┴─────────┴─────────┴─────────┘ */

            bindings = <
&trans  &trans     &trans  &trans      &trans  &trans  &trans  &kp RA(U)  &trans  &trans
&trans  &kp RA(S)  &trans  &trans      &trans  &trans  &trans  &trans     &trans  &kp RA(O)
&trans  &trans     &trans  &trans      &trans  &trans  &trans  &trans     &trans  &trans
                           &mo ADJUST  &trans  &trans  &trans  &trans     &trans
            >;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        adjust_layer {
            // ┌─────────────────────────────────────────────────┐

            label = "ADJUST";

            // └─────────────────────────────────────────────────┘
            /* ┌─────────┬─────────┬─────────┬─────────┬─────────┐┌─────────┬─────────┬─────────┬─────────┬─────────┐
   │         │         │         │         │         ││         │         │         │         │         │
   ┌─────────┼─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┼─────────┐
   │         │         │         │         │         ││         │         │         │         │         │
   ├─────────┼─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┼─────────┤
   │         │         │         │         │         ││         │         │         │         │         │
   └─────────┴─────────┼─────────┼─────────┼─────────┼┼─────────┼─────────┼─────────┼─────────┴─────────┘
                       │         │         │         ││         │         │         │  
                       └─────────┴─────────┴─────────┘└─────────┴─────────┴─────────┘ */

            bindings = <
&bt BT_CLR  &trans  &trans  &trans     &trans  &trans      &trans  &trans  &trans      &bt BT_CLR
&bt BT_NXT  &trans  &trans  &trans     &trans  &trans      &trans  &trans  &bt BT_NXT  &trans
&bt BT_PRV  &trans  &trans  &kp KP_N6  &trans  &bt BT_PRV  &trans  &trans  &trans      &trans
                            &trans     &trans  &trans      &trans  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
